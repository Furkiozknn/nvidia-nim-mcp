# Recommended — unlocks the highest-quality tier of every tool. Free, no
# credit card: https://build.nvidia.com/ . Not strictly required:
# generate_image and create_embedding have keyless tiers, and the rest run
# off any one of the free-tier keys below.
NVIDIA_API_KEY=

# Optional — extend the fallback chain. Each is skipped silently if unset.
# Groq and Mistral have free tiers.
GROQ_API_KEY=
MISTRAL_API_KEY=
# Gemini may answer PERMISSION_DENIED unless the Google project is on a paid plan.
GEMINI_API_KEY=
# Cerebras is not free: it answers "Payment required" without a payment method.
CEREBRAS_API_KEY=

# Optional — where generated images and embeddings are written.
# Default: ./output relative to the directory you run the server from.
NVIDIA_NIM_OUTPUT_DIR=
